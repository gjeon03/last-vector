{
  "name": "last-vector",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LAST VECTOR — a browser-native spacecraft flight game.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:i18n": "node --experimental-strip-types scripts/playtest/i18n-contract.mjs",
    "test:campaign": "node --experimental-strip-types scripts/playtest/campaign-contract.mjs",
    "test:dead-signal": "node --experimental-strip-types scripts/playtest/dead-signal-contract.mjs",
    "test:boost": "node --experimental-strip-types scripts/playtest/boost-contract.mjs",
    "test:stage-landmarks": "node --experimental-strip-types scripts/playtest/stage-landmarks-contract.mjs",
    "serve:dist": "node scripts/static-server.mjs",
    "playtest": "node scripts/playtest/playtest.mjs",
    "playtest:perf": "node scripts/playtest/perf-probe.mjs",
    "playtest:boost-vfx": "node scripts/playtest/boost-vfx-probe.mjs",
    "playtest:campaign": "node scripts/playtest/campaign.mjs",
    "playtest:chapter-visual": "node scripts/playtest/chapter-visual.mjs",
    "playtest:chapter-perf": "node scripts/playtest/chapter-perf.mjs",
    "playtest:screenshots": "node scripts/playtest/screenshot-matrix.mjs",
    "playtest:all": "node scripts/playtest/all.mjs"
  },
  "devDependencies": {
    "@types/three": "0.172.0",
    "playwright": "^1.55.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "dependencies": {
    "three": "^0.172.0"
  }
}
